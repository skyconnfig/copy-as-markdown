    "help_inputObjectDesc": {
        "message": "The input object contains 2 attributes: $L$ for flattened links, and $G$ for links grouped in Tab Groups (supported browsers only).",
        "placeholders": {
            "l": {
                "content": "$1"
            },
            "g": {
                "content": "$2"
            }
        }
    },
    "help_groupOrderNote": {
        "message": "Tab Groups appear in its original order. For tabs that belong to a Tab Group, they will be gathered in an entry with $A$ attribute. The tabs appear in its nested $L$ array. For tabs that do not belong to any Tab Group, they will appear at the top level.",
        "placeholders": {
            "a": {
                "content": "$1"
            },
            "l": {
                "content": "$2"
            }
        }
    },
    "help_loopNote": {
        "message": "In loops, use $I$ for 0-based indexes, and $N$ for 1-based indexes.",
        "placeholders": {
            "i": {
                "content": "$1"
            },
            "n": {
                "content": "$2"
            }
        }
    },
