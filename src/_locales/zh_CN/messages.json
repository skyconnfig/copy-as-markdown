    "help_multipleTabs": {
        "message": "多个标签页"
    },
    "help_inputObjectDesc": {
        "message": "输入对象包含 2 个属性：$L$ 用于扁平化的链接列表，$G$ 用于按标签页组归类的链接（仅限支持的浏览器）。",
        "placeholders": {
            "l": {
                "content": "$1"
            },
            "g": {
                "content": "$2"
            }
        }
    },
    "help_groupOrderNote": {
        "message": "标签页组按原始顺序显示。属于某个组的标签页将汇总到带有 $A$ 属性的条目中。标签页出现在其嵌套的 $L$ 数组中。不属于任何组的标签页将显示在顶层。",
        "placeholders": {
            "a": {
                "content": "$1"
            },
            "l": {
                "content": "$2"
            }
        }
    },
    "help_loopNote": {
        "message": "在循环中，使用 $I$ 获取从 0 开始的索引，使用 $N$ 获取从 1 开始的编号。",
        "placeholders": {
            "i": {
                "content": "$1"
            },
            "n": {
                "content": "$2"
            }
        }
    },
