{
  "name": "__MSG_extensionName__",
  "version": "3.4.1",
  "version_name": "3.4.1",
  "manifest_version": 3,
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "tabGroups",
    "tabs"
  ],
  "action": {
    "default_icon": {
      "128": "dist/static/images/icon-128.png"
    },
    "default_title": "Copy as Markdown...",
    "default_popup": "./dist/static/popup.html",
    "browser_style": true
  },
  "icons": {
    "16": "dist/static/images/icon-16.png",
    "48": "dist/static/images/icon-48.png",
    "128": "dist/static/images/icon-128.png"
  },
  "background": {
    "service_worker": "./dist/background.js",
    "type": "module"
  },
  "commands": {
    "selection-as-markdown": {
      "description": "__MSG_command_selectionAsMarkdown__"
    },
    "current-tab-link": {
      "description": "__MSG_command_currentTabLink__"
    },
    "current-tab-custom-format-1": {
      "description": "__MSG_command_currentTabCustom1__"
    },
    "current-tab-custom-format-2": {
      "description": "__MSG_command_currentTabCustom2__"
    },
    "current-tab-custom-format-3": {
      "description": "__MSG_command_currentTabCustom3__"
    },
    "current-tab-custom-format-4": {
      "description": "__MSG_command_currentTabCustom4__"
    },
    "current-tab-custom-format-5": {
      "description": "__MSG_command_currentTabCustom5__"
    },
    "all-tabs-link-as-list": {
      "description": "__MSG_command_allTabsLinkAsList__"
    },
    "all-tabs-link-as-task-list": {
      "description": "__MSG_command_allTabsLinkAsTaskList__"
    },
    "all-tabs-title-as-list": {
      "description": "__MSG_command_allTabsTitleAsList__"
    },
    "all-tabs-url-as-list": {
      "description": "__MSG_command_allTabsUrlAsList__"
    },
    "highlighted-tabs-link-as-list": {
      "description": "__MSG_command_selectedTabsLinkAsList__"
    },
    "highlighted-tabs-link-as-task-list": {
      "description": "__MSG_command_selectedTabsLinkAsTaskList__"
    },
    "highlighted-tabs-title-as-list": {
      "description": "__MSG_command_selectedTabsTitleAsList__"
